{
  "name": "azrail-pulse-unified",
  "version": "1.5.0-rc.63",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"console.error('Deployment is disabled in this local RC. Verify ZIP first, then enable an explicit deployment flow.'); process.exit(2)\"",
    "types": "wrangler types",
    "db:schema": "node -e \"console.error('Direct remote schema writes are disabled. Use db:migrate:* plan commands, then an explicitly approved apply.'); process.exit(2)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "check": "npm run build:ui && npm run typecheck && npm test",
    "build:check": "npm run build:check:staging && npm run build:check:production",
    "db:security": "node -e \"console.error('Direct remote security migration is disabled. Use db:migrate:* with explicit approval.'); process.exit(2)\"",
    "db:migrate": "node scripts/migrate.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:ui": "node scripts/build-ultimate.mjs && node scripts/build-unified.mjs",
    "predeploy": "npm run build:ui",
    "build": "node scripts/build-unified.mjs",
    "provision": "node scripts/provision.mjs",
    "deploy:ci": "node scripts/deploy-ci.mjs",
    "deploy:staging": "node -e \"console.error('Staging deploy is locked. Use staging:deploy:check/plan, then deploy:staging:apply only after explicit owner approval.'); process.exit(2)\"",
    "deploy:production": "node -e \"console.error('Production deploy is disabled in this local RC. Run npm run build:check:production only.'); process.exit(2)\"",
    "build:check:staging": "wrangler deploy --dry-run --config wrangler.staging.json --outdir .work/staging-worker --containers-rollout=none",
    "build:check:production": "wrangler deploy --dry-run --config wrangler.production.json --outdir .work/production-worker --containers-rollout=none",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:check": "npm run quality",
    "db:migrate:local": "node scripts/migrate.mjs --local",
    "db:migrate:staging:plan": "node scripts/migrate.mjs --remote --config wrangler.staging.json",
    "db:migrate:production:plan": "node scripts/migrate.mjs --remote --config wrangler.production.json",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/check-version-truth.mjs",
    "prebuild": "npm run config:generate && npm run version:sync",
    "pretest": "npm run config:generate && npm run version:sync",
    "docs:check": "node scripts/check-doc-truth.mjs",
    "migrations:check": "node scripts/check-migration-integrity.mjs",
    "source:manifest": "node scripts/build-source-manifest.mjs",
    "cloud:drift": "node scripts/cloud-drift.mjs --snapshot verification/cloudflare-snapshot.json --env all",
    "cloud:drift:staging": "node scripts/cloud-drift.mjs --snapshot verification/cloudflare-snapshot.json --env staging --out .work/cloud-drift-staging.json",
    "cloud:drift:production": "node scripts/cloud-drift.mjs --snapshot verification/cloudflare-snapshot.json --env production --out .work/cloud-drift-production.json",
    "release:check:static": "npm run quality:static",
    "config:generate": "node scripts/generate-configs.mjs",
    "config:check": "node scripts/generate-configs.mjs --check",
    "release:package": "node scripts/build-release-package.mjs",
    "release:verify": "node scripts/verify-release-package.mjs",
    "lint": "node scripts/code-hygiene.mjs",
    "format:check": "node scripts/code-hygiene.mjs --format",
    "security:check": "node scripts/security-check.mjs",
    "quality:static": "node scripts/quality-gate.mjs --static",
