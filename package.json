    "image:check": "node scripts/check-image-studio-architecture.mjs",
    "music:check": "node scripts/check-music-studio-architecture.mjs",
    "video:check": "node scripts/check-video-studio-architecture.mjs",
    "audio:check": "node scripts/check-audio-lab-architecture.mjs",
    "ableton:check": "node scripts/check-ableton-lab-architecture.mjs",
    "data:check": "node scripts/check-data-studio-architecture.mjs",
    "ledger:check": "node scripts/check-ledger-studio-architecture.mjs",
    "pulse:check": "node scripts/check-pulse-lab-architecture.mjs",
    "connections:check": "node scripts/check-connections-architecture.mjs",
    "node24:env": "node scripts/check-node24-environment.mjs",
    "node24:check": "node scripts/check-node24-verification.mjs",
    "node24:suite": "node scripts/node24-suite.mjs",
