    "staging:migration:simulate": "node scripts/staging-migration-simulate.mjs",
    "db:migrate:staging:apply": "node scripts/staging-migration-apply.mjs",
    "staging:deploy:check": "node scripts/check-staging-deploy-preparation.mjs",
    "staging:deploy:plan": "node scripts/staging-deploy-plan.mjs",
    "deploy:staging:apply": "node scripts/staging-deploy-apply.mjs",
    "staging:smoke:check": "node scripts/check-staging-smoke-preparation.mjs",
    "staging:smoke:simulate": "node scripts/staging-smoke-simulate.mjs",
    "staging:smoke:plan": "node scripts/staging-smoke-plan.mjs",
    "staging:smoke:run": "node scripts/staging-smoke-run.mjs",
    "sbom:build": "node scripts/build-sbom.mjs",
    "dependency:check": "node scripts/check-dependency-lock.mjs",
    "security:verify:check": "node scripts/check-security-verification-preparation.mjs",
    "security:verify:simulate": "node scripts/security-verification-simulate.mjs",
    "security:verify:plan": "node scripts/security-verification-plan.mjs",
    "security:verify:run": "node scripts/security-verification-run.mjs",
    "production:drift:check": "node scripts/check-production-drift-reconciliation.mjs",
    "production:drift:simulate": "node scripts/production-drift-simulate.mjs",
    "production:drift:plan": "node scripts/production-drift-plan.mjs",
    "production:drift:strict": "node scripts/check-production-drift-reconciliation.mjs --strict",
    "backup:restore:check": "node scripts/check-backup-restore-proof.mjs",
    "backup:restore:simulate": "node scripts/backup-restore-simulate.mjs",
    "backup:restore:plan": "node scripts/backup-restore-plan.mjs",
    "backup:restore:strict": "node scripts/check-backup-restore-proof.mjs --strict",
    "production:approval:check": "node scripts/check-production-approval-gate.mjs",
    "production:approval:plan": "node scripts/production-approval-plan.mjs",
    "production:approval:authorize": "node scripts/production-approval-authorize.mjs",
    "source:manifest:check": "node scripts/check-source-manifest.mjs",
    "github:pr:check": "node scripts/check-github-pr-preparation.mjs",
    "github:pr:plan": "node scripts/github-pr-plan.mjs",
    "github:pr:ticket": "node scripts/github-pr-publication-ticket.mjs",
    "production:release:check": "node scripts/check-production-release-preparation.mjs",
    "production:release:simulate": "node scripts/production-release-simulate.mjs",
    "production:release:plan": "node scripts/production-release-plan.mjs",
    "production:release:apply": "node scripts/production-release-apply.mjs",
    "production:release:finalize": "node scripts/production-release-finalize.mjs",
    "repo:hygiene": "node scripts/check-repo-hygiene.mjs",
    "dependency:audit": "npm audit --audit-level=high",
    "repo:exhaustive": "node scripts/check-repo-exhaustive.mjs",
    "staging:auto-deploy:check": "node scripts/check-staging-autodeploy.mjs",
    "staging:auto-health": "node scripts/staging-auto-health.mjs",
    "repo:deep": "node scripts/check-deep-audit.mjs",
    "series:e:check": "node scripts/check-series-e-foundation.mjs",
    "series:e:runtime": "node scripts/check-series-e-runtime.mjs",
    "series:e:web": "node scripts/check-series-e-web.mjs",
    "series:e:completion": "node scripts/check-series-e-completion.mjs",
    "series:fg:check": "node scripts/check-series-fg-foundation.mjs",
    "series:f:music": "node scripts/check-series-f-music-runtime.mjs",
    "build:ui:fallback": "node scripts/build-ui-fallback.mjs",
    "series:f:image": "node scripts/check-series-f-image-runtime.mjs",
    "series:f:video": "node scripts/check-series-f-video-runtime.mjs",
    "series:f:metatron": "node scripts/check-series-f-metatron-runtime.mjs",
    "series:f:modules": "node scripts/check-series-f-universal-modules.mjs",
    "series:g:check": "node scripts/check-series-g-system.mjs",
    "series:g:live-e2e": "node scripts/series-g-live-e2e.mjs",
    "cross:final": "node scripts/check-cross-cutting-final.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/sandbox": "0.12.9",
    "agents": "^0.8.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "jose": "^6.2.12",
    "zod": "^3.25.76"
